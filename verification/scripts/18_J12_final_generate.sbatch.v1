#!/bin/bash
# J12 final — the train-fold-selected constant on the TEST fold (same 400 images/seeds as J4/J5/J5c). Run after j12_select.py. NOT SUBMITTED.
# J5b — fixed-schedule arm, GENERATE stage (8 shards). Inference only.
# Each committed policy is replaced by a constant action = its mean raw action
# over all env steps recorded by J6 (fixed_schedule_eval.py). Same view
# (committed), images, n_eval and per-image seeds as J5 and eval 17695832.
# Needs all 8 J6 outputs in ~/verification/out/actions/, hence afterok on J6:
#   J5B=$(sbatch --parsable --dependency=afterok:$J6 10_fixed_schedule_generate.sbatch)
#   sbatch --dependency=afterok:$J5B 11_fixed_schedule_reduce.sbatch
#SBATCH --job-name=verif-J12-final-gen
#SBATCH --array=0-7
#SBATCH --partition=publicgpu
#SBATCH --account=insa
#SBATCH --gres=gpu:1
#SBATCH --constraint="gpuh200|gpuh100|gpua100|gpul40s"
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=03:00:00
#SBATCH --output=/home2020/home/insa/arbaoui/verification/logs/%x-%A_%a.out
#SBATCH --error=/home2020/home/insa/arbaoui/verification/logs/%x-%A_%a.err
set -euo pipefail
TAG=J12_grid_fixed_schedule
OUT="$HOME/verification/out/$TAG"; mkdir -p "$OUT/shards"
cd "$HOME/verification/code/49e6050"
module load python/3.12.8; module load cuda/cuda-12.1
source venv/bin/activate
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 YOLO_OFFLINE=1 PYTHONPATH="$PWD"
export PPO_CKPT_DIR="$HOME/verification/views/committed"
source "$HOME/verification/scripts/adapters_committed.env"   # n->p committed, p->n pn_lora adapter
echo "=== $TAG shard ${SLURM_ARRAY_TASK_ID}: code 49e6050 view=committed on $(hostname) at $(date)"
nvidia-smi --query-gpu=name,memory.total --format=csv
python -u preflight_gpu.py
python -u "$HOME/verification/scripts/fixed_schedule_eval.py" "$HOME/verification/out/J12_grid/select/J12_schedule.json" \
    --stage generate --shard "${SLURM_ARRAY_TASK_ID}" --num-shards 8 --n-eval 200 \
    --arm trained --shard-dir "$OUT/shards" --tag "$TAG" --base-seed 0
echo "=== finished at $(date)"
