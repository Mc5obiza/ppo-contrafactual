"""J12 selection (CPU): per direction, among stage-2 configs, max mean discounted return over all
N1+N2 = 48 training-fold images (stage 1 + stage 2 rows). Writes the constant schedule in the
fixed_schedule.json format, for fixed_schedule_eval.py <schedule.json> on the TEST fold."""
import json, os, sys
d = sys.argv[1]; out = {}
for direction in ['n_to_p', 'p_to_n']:
    load = lambda st: {r['name']: r for r in (json.load(open(os.path.join(d, f))) for f in os.listdir(d) if f.startswith(f'stage{st}_{direction}_'))}
    s1, s2 = load(1), load(2)
    assert len(s2) == 6, f'{direction}: stage 2 incomplete ({len(s2)}/6)'
    score = {n: (sum(r['ret'] for r in s1[n]['rows'] + s2[n]['rows']) / (len(s1[n]['rows']) + len(s2[n]['rows']))) for n in s2}
    best = max(score, key=score.get)
    out[direction] = dict(mean_raw_action=s2[best]['raw'], config=best, controls=s2[best]['controls'],
                          train_fold_mean_return_48=score[best], ranking=sorted(score.items(), key=lambda kv: -kv[1]),
                          reference_policy_mean_return_12=s1['REF_policy_mean']['mean_return'],
                          n_steps=None, n_images=48)
    print(direction, best, round(score[best], 4), '| reference (policy mean, 12 imgs):', round(s1['REF_policy_mean']['mean_return'], 4))
json.dump(out, open(os.path.join(d, 'J12_schedule.json'), 'w'), indent=1)
