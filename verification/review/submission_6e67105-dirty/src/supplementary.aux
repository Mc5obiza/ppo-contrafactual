\@writefile{lot}{\contentsline {table}{\numberline {E2}{\ignorespaces Five runs on the same 400 test images and seeds. CV with Wilson 95\% CIs; LHR with a $t$-interval (concentration and fraction changed have $t$-interval half-widths $\leq 0.01$); transfer per validator with a 10{,}000-resample bootstrap, the mean with a paired bootstrap over per-image deltas. $^{\dagger }$Second seed: shared adapter, resumed training.\relax }}{8}{table.caption.28}}
\newlabel{tab:suppl-fourarm}{{E2}{8}{Five runs on the same 400 test images and seeds. CV with Wilson 95\% CIs; LHR with a $t$-interval (concentration and fraction changed have $t$-interval half-widths $\leq 0.01$); transfer per validator with a 10{,}000-resample bootstrap, the mean with a paired bootstrap over per-image deltas. $^{\dagger }$Second seed: shared adapter, resumed training.\relax }{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {E3}{\ignorespaces Edit locality and distribution metrics, $n=200$ per direction and run. ``in $m$'' and ``in lung'': share of $\DOTSB \sum@ \slimits@ |x_c - x|$ inside the editable region and the lung mask, with the area fraction (uniform-edit null) in parentheses. ``changed'': fraction of pixels with $|\cdot | > 0.01$ against $x$, against $D(E(x))$, and for $D(E(x))$ itself. ``out of $m$'': share of $\DOTSB \sum@ \slimits@ |x_c - D(E(x))|$ outside the editable region. Locality values have 95\% $t$-interval half-widths $\leq 0.017$. KID $\times 10^3$, mean $\pm $ s.d.\ over subsets.\relax }}{8}{table.caption.30}}
\newlabel{tab:suppl-locality}{{E3}{8}{Edit locality and distribution metrics, $n=200$ per direction and run. ``in $m$'' and ``in lung'': share of $\sum |x_c - x|$ inside the editable region and the lung mask, with the area fraction (uniform-edit null) in parentheses. ``changed'': fraction of pixels with $|\cdot | > 0.01$ against $x$, against $D(E(x))$, and for $D(E(x))$ itself. ``out of $m$'': share of $\sum |x_c - D(E(x))|$ outside the editable region. Locality values have 95\% $t$-interval half-widths $\leq 0.017$. KID $\times 10^3$, mean $\pm $ s.d.\ over subsets.\relax }{table.caption.30}{}}
