# Environments / caches
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets / local config / tooling
.env
.env.*
*.key
*.pem
.claude/settings.local.json
wandb/
tensorboard/
runs/

# Model weights and tensors, anywhere in the repo.
# Results next to them (eval_metrics.json, diff plots, run manifests,
# guidance diagnostics, validation jsons) stay tracked on purpose.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
checkpoint/

# Datasets (RSNA, CBIS-DDSM, CMMD, NODE21): never redistribute
data/
datasets/
*.dcm
*.nii
*.nii.gz

# Job logs are disposable; the run manifests are the forensic trail.
logs/*
!logs/*.manifest

# Derived medical images (raw counterfactual candidates, Grad-CAM dumps).
# Paper/report figures are tracked in their own folders.
outputs/

# Scratch
tree.txt
*.tmp

# LaTeX build byproducts
report/*.aux
report/*.log
report/*.out
report/*.toc
internship-report/*.pdf
internship-report/main.aux
internship-report/main.log
internship-report/main.out
internship-report/main.toc
internship-report/main.lof
internship-report/main.lot
internship-report/chapters/*.aux
internship-report/frontmatter/*.aux
internship-report/backmatter/*.aux
CVPR_2026_Submission_Template/*.aux
CVPR_2026_Submission_Template/*.log