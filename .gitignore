venv/
__pycache__/
/src/__pycache__
/factory/__pycache__
*.pyc
checkpoint/
yolov8n.pt

# Job logs are large and disposable, but the run manifests inside them are the
# forensic trail (commit, dirty state, config values a run actually used) and
# must survive. See record_run_manifest.sh.
logs/*
!logs/*.manifest

# Model weights, PPO/LoRA state, and raw counterfactual shard tensors
# (checkpoints/*/eval_shards*/cf_shard_*.pt) are large -- hundreds of MB to a
# few GB per directory -- and fully regenerable from a training/eval run.
# Everything else under checkpoints/ at any depth -- eval_metrics.json, diff
# plots, run manifests, guidance diagnostics, held-out validation results --
# IS the recorded result of a run and must be pushed, so only the tensor
# files themselves are excluded here, never a whole directory. (A previous
# version of this file excluded checkpoints/*/* wholesale and only rescued a
# few specific top-level filenames, which silently dropped every per-arm
# eval_metrics.json and diff plot -- e.g. checkpoints/eval_none/eval_metrics.json
# -- the moment a result moved one directory deeper than the rules expected.)
checkpoints/**/*.pt
checkpoints/**/*.pth

# LaTeX build byproducts for report/report.tex: regenerated by pdflatex,
# never hand-edited, pure diff noise. report.pdf is left trackable so a
# reader can see the result without a LaTeX toolchain.
report/*.aux
report/*.log
report/*.out
report/*.toc

# internship-report/ mixes LaTeX source (tracked: chapters/, frontmatter/,
# backmatter/, figures/, logos/, preamble.tex, main.tex) with regenerated
# PDFs and build scratch files (not tracked). main.pdf and
# internship-report.pdf are pdflatex output; Rapport_Stage_Melki_Ayoub.pdf
# here is a duplicate of the canonical tracked copy at
# report/Rapport_Stage_Melki_Ayoub.pdf.
internship-report/*.pdf
internship-report/main.aux
internship-report/main.log
internship-report/main.out
internship-report/main.toc
internship-report/main.lof
internship-report/main.lot
# \include generates a per-included-file .aux alongside main.aux.
internship-report/chapters/*.aux
internship-report/frontmatter/*.aux
internship-report/backmatter/*.aux
